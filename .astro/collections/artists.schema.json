{
  "$ref": "#/definitions/artists",
  "definitions": {
    "artists": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "discipline": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "project": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/images\\/",
            "errorMessage": {
              "pattern": "Use a path under /images/"
            }
          },
          "default": []
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "summary": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "discipline",
        "year",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}