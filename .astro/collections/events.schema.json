{
  "$ref": "#/definitions/events",
  "definitions": {
    "events": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "festival",
            "flea-market",
            "workshop",
            "wedding",
            "community",
            "creative",
            "experimental"
          ]
        },
        "venue": {
          "type": "string",
          "enum": [
            "front-yard",
            "back-yard",
            "house",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "upcoming",
            "past",
            "cancelled"
          ],
          "default": "upcoming"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/images\\/",
            "errorMessage": {
              "pattern": "Use a path under /images/"
            }
          },
          "default": []
        },
        "link": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "date",
        "category",
        "venue",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}