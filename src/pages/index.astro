---
import Layout from '../layouts/Base.astro';
---

<Layout title="Daira | Kerala Artisanal Stay">
  <main class="min-h-screen flex flex-col items-center justify-center p-8 text-center bg-[#1c1e1b] text-[#e2e4df]">
    <h1 class="text-5xl font-bold tracking-tight mb-4">DAIRA</h1>
    <p class="text-lg text-[#a3a89e] max-m-md">
      An artisanal stay & creative space in Kerala.
    </p>
    <a href="/design/" class="mt-6 px-4 py-2 border border-[#a3a89e]/30 rounded text-sm hover:border-white transition-colors">
      View Design Tokens (/design/)
    </a>
  </main>
</Layout>
