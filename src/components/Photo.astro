---
import { images, resolve, resolveFile, type SlotKey } from '../config/images';
interface Props { slot?: SlotKey; src?: string; label?: string; alt?: string; ratio?: string; ring?: boolean; fill?: boolean; priority?: boolean; reveal?: boolean; sizes?: string; class?: string; }
const { slot, src, label, alt, ratio = '4 / 5', ring = false, fill = false, priority = false, reveal = false, sizes = '100vw', class: cls = '' } = Astro.props;
const img = slot ? resolve(images[slot]) : resolveFile(src ?? '', label ?? 'IMAGE', alt ?? label ?? '');
if (slot && label) img.label = label;
const style = ring ? undefined : `aspect-ratio:${ratio}`;
const classes = ['photo', ring && 'ring', fill && 'fill', cls];
---
{img.exists ? (
  <div class:list={classes} style={style} data-reveal={reveal ? '' : undefined}>
    <img src={img.src} alt={alt ?? img.alt} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
  </div>
) : (
  <div class:list={[...classes, 'photo--placeholder']} style={style} role="img" aria-label={`Placeholder: ${img.label}`}>
    <span>DAIRA IMAGE — {img.label}</span>
  </div>
)}
<style is:global>
  .photo.fill { height: 100%; min-height: 55vh; }
</style>
