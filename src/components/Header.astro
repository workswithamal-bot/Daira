---
import { site } from '../config/site';
import { nav, bookLink } from '../config/nav';
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="mark" aria-label={`${site.name} home`}>
      {site.logoSrc ? <img src={site.logoSrc} alt={site.name} height="28" /> : <span>{site.name}</span>}
    </a>
    <nav aria-label="Primary" class="desktop">
      <ul>
        {nav.filter((n) => n.href !== '/').map((n) => (
          <li><a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <button type="button" id="theme-toggle" class="icon" aria-label="Switch between light and dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
      </button>
      <a href={bookLink.href} class="btn btn--solid book">{bookLink.label}</a>
      <button type="button" id="menu-open" class="icon menu-btn" aria-expanded="false" aria-controls="menu">Menu</button>
    </div>
  </div>
  <div id="menu" class="menu" hidden role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="wrap menu-inner">
      <button type="button" id="menu-close" class="icon">Close</button>
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a href={bookLink.href}>Book your stay</a></li>
      </ul>
      <p class="label">{site.tagline}</p>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); border-bottom: var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); min-height: 4rem; }
  .mark { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); letter-spacing: -0.04em; text-decoration: none; }
  .desktop ul { display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  .desktop a { font-family: var(--font-display); font-size: var(--step--1); text-transform: var(--label-case); text-decoration: none; padding-block: var(--space-2); background: linear-gradient(var(--thread), var(--thread)) left bottom / 0 1px no-repeat; transition: background-size var(--dur-base) var(--ease-out); }
  .desktop a:hover, .desktop a[aria-current='page'] { background-size: 100% 1px; }
  .tools { display: flex; align-items: center; gap: var(--space-3); }
  .icon { background: none; border: 0; color: inherit; font-family: var(--font-display); font-size: var(--step--1); cursor: pointer; min-height: 2.75rem; min-width: 2.75rem; padding: 0 var(--space-2); }
  .menu-btn { display: none; }
  .menu { position: fixed; inset: 0; background: var(--bg); z-index: 60; overflow-y: auto; }
  .menu[hidden] { display: none; }
  .menu-inner { display: flex; flex-direction: column; gap: var(--space-7); padding-block: var(--space-4); min-height: 100%; }
  .menu-inner > .icon { align-self: flex-end; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu li { border-top: var(--border); }
  .menu a { display: block; font-family: var(--font-display); font-size: var(--step-3); letter-spacing: -0.03em; text-decoration: none; padding-block: var(--space-3); }
  .menu a[aria-current='page'] { color: var(--accent); }
  @media (max-width: 63.99rem) { .desktop { display: none; } .menu-btn { display: inline-flex; align-items: center; } .book { display: none; } }
</style>

<script>
  const menu = document.getElementById('menu')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => setMenu(true));
  closeBtn.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setMenu(false); });
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = [...menu.querySelectorAll<HTMLElement>('a, button')];
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('daira-theme', next); } catch {}
  });
</script>
